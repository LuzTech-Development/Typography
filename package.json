    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@editframe/elements": "0.59.42",
    "@editframe/react": "0.59.42",
    "@editframe/vite-plugin": "0.59.42",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@paper-design/shaders-react": "0.0.80",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "archiver": "^8.0.0",
    "astro": "^7.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
