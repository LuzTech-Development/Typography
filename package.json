{
  "name": "@luztech/typography",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "author": "LuzTech Development",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuzTech-Development/Typography"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "node scripts/generate-assets-if-stale.mjs && astro dev",
