---
import type { Locale } from '@/i18n';
import { localePrefix, t } from '@/lib/i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const p = localePrefix(locale);
---

<section class="relative overflow-hidden border-b border-white/[0.06]">
    <div
        class="pointer-events-none absolute inset-0 opacity-20"
        style="background: radial-gradient(ellipse at 20% 20%, #00ff9d33, transparent 50%), radial-gradient(ellipse at 80% 30%, #1f6fef33, transparent 50%), radial-gradient(ellipse at 50% 80%, #4665c333, transparent 50%)"
        aria-hidden="true"
    ></div>
    <div class="container-editorial relative flex min-h-[70vh] flex-col justify-center py-32">
        <p class="eyebrow">{dict.hero.eyebrow}</p>
        <h1 class="display-heading mt-6 max-w-4xl text-balance" style="font-size: clamp(2.5rem, 7vw, 5.5rem)">
            {dict.hero.title}
        </h1>
        <p class="mt-8 max-w-2xl text-lg text-paper/75">{dict.hero.lede}</p>
        <div class="mt-10 flex flex-wrap gap-4">
            <a href={`${p}/#icons`} class="btn btn--primary">{dict.hero.ctaIcons}</a>
            <a href={`${p}/#instructions`} class="btn btn--ghost">{dict.hero.ctaInstructions}</a>
        </div>
    </div>
</section>
