---
import type { Locale } from '@/i18n';
import { t } from '@/lib/i18n';
import { IconDownloader } from './IconDownloader.tsx';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const d = dict.icons.download;

const variantLabels = {
    clean: dict.icons.variants.clean,
    name: dict.icons.variants.name,
    blog: dict.icons.variants.blog,
    nfse: dict.icons.variants.nfse
} as const;
---

<section class="py-20">
    <div class="container-editorial">
        <p class="eyebrow">{dict.icons.eyebrow}</p>
        <h2 class="display-heading mt-4 text-3xl md:text-4xl">
            {dict.icons.title}
        </h2>
        <p class="text-paper/75 mt-6 max-w-2xl text-lg">{dict.icons.lede}</p>

        <!-- Downloader -->
        <div class="mt-12">
            <IconDownloader
                client:load
                labels={{
                    variant: d.variant,
                    format: d.format,
                    size: d.size,
                    color: d.color,
                    download: d.download,
                    downloadAll: d.downloadAll,
                    downloadAllHint: d.downloadAllHint,
                    copyUrl: d.copyUrl,
                    copied: d.copied,
                    svg: d.svg,
                    png: d.png,
                    colors: d.colors
                }}
                variantLabels={variantLabels}
            />
        </div>

        <!-- Download all -->
        <div
            class="bg-ink-soft mt-8 flex flex-col items-start gap-4 rounded-xl border border-white/[0.08] p-8 md:flex-row md:items-center md:justify-between">
            <div>
                <h3 class="text-xl font-bold">{d.downloadAll}</h3>
                <p class="text-ink-muted mt-2 text-sm">{d.downloadAllHint}</p>
            </div>
            <a href="/luztech-icons.zip" download class="btn btn--primary">
                {d.downloadAll}
            </a>
        </div>

        <!-- URL pattern -->
        <div class="bg-ink-soft mt-8 rounded-xl border border-white/[0.08] p-8">
            <h3 class="text-lg font-bold">{dict.icons.urlPattern}</h3>
            <p class="text-ink-muted mt-2 text-sm">
                {dict.icons.urlPatternHint}
            </p>
            <pre
                class="bg-ink text-luz-mint mt-4 overflow-x-auto rounded-lg p-4 font-mono text-sm"><code>/icons/&lt;variant&gt;/&lt;size&gt;/[inverted/]&lt;color&gt;.png</code></pre>
        </div>
    </div>
</section>
