---
import type { Locale } from '@/i18n';
import { localePrefix, t } from '@/lib/i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const s = dict.instructions.sections;
const p = localePrefix(locale);

const repoUrl = 'https://github.com/LuzTech-Development/Typography';

const cards = [
    {
        title: s.icons,
        text: s.iconsText,
        href: `${p}/icons/`,
        cta: dict.nav.icons
    },
    {
        title: s.font,
        text: s.fontText,
        href: `${p}/font/`,
        cta: dict.nav.font
    },
    {
        title: s.backgrounds,
        text: s.backgroundsText,
        href: `${p}/backgrounds/`,
        cta: dict.nav.backgrounds
    },
    {
        title: s.licenses,
        text: s.licensesText,
        href: `${p}/licenses/`,
        cta: dict.nav.licenses
    }
];
---

<section class="border-b border-white/6 py-14 md:py-20">
    <div class="container-editorial">
        <p class="eyebrow">{dict.instructions.eyebrow}</p>
        <h2 class="display-heading mt-4 text-3xl md:text-4xl">
            {dict.instructions.title}
        </h2>
        <p class="text-paper/75 mt-6 max-w-2xl text-base md:text-lg">
            {dict.instructions.lede}
        </p>

        <div
            class="mt-10 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-6 lg:grid-cols-4">
            {
                cards.map(card => (
                    <a
                        href={card.href}
                        class="group bg-ink-soft hover:border-luz-mint/40 flex flex-col rounded-xl border border-white/8 p-6 transition md:p-8">
                        <h3 class="group-hover:text-luz-mint text-xl font-bold">
                            {card.title}
                        </h3>
                        <p class="text-paper/75 mt-4 flex-1">{card.text}</p>
                        <span class="stamp-num text-luz-mint mt-6">
                            {card.cta} →
                        </span>
                    </a>
                ))
            }
        </div>

        <div
            class="bg-ink-soft mt-10 rounded-xl border border-white/8 p-6 md:mt-12 md:p-8">
            <h3 class="text-xl font-bold">{s.source}</h3>
            <p class="text-paper/75 mt-4">{s.sourceText}</p>
            <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border-luz-mint/40 text-luz-mint hover:bg-luz-mint/10 mt-6 inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition">
                {s.sourceCta} →
            </a>
        </div>
    </div>
</section>
