---
import type { Locale } from '@/i18n';
import { t } from '@/lib/i18n';
import {
    BACKGROUND_COLORS,
    BackgroundGenerator
} from './BackgroundGenerator.tsx';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const d = dict.backgrounds.download;
const colors = dict.backgrounds.colors;
const cornerColors = [
    { label: colors.topLeft, hex: BACKGROUND_COLORS.tl },
    { label: colors.topRight, hex: BACKGROUND_COLORS.tr },
    { label: colors.bottomLeft, hex: BACKGROUND_COLORS.bl },
    { label: colors.bottomRight, hex: BACKGROUND_COLORS.br }
];
---

<section class="py-14 md:py-20">
    <div class="container-editorial">
        <p class="eyebrow">{dict.backgrounds.eyebrow}</p>
        <h2 class="display-heading mt-4 text-3xl md:text-4xl">
            {dict.backgrounds.title}
        </h2>
        <p class="text-paper/75 mt-6 max-w-2xl text-base md:text-lg">
            {dict.backgrounds.lede}
        </p>

        <!-- Generator -->
        <div class="mt-10 md:mt-12">
            <BackgroundGenerator
                client:load
                labels={{
                    width: d.width,
                    height: d.height,
                    size: d.size,
                    lockRatio: d.lockRatio,
                    download: d.download,
                    downloading: d.downloading,
                    hint: d.hint,
                    tabs: dict.backgrounds.tabs,
                    swirled: dict.backgrounds.swirled,
                    animated: dict.backgrounds.animated
                }}
            />
        </div>

        <div class="mt-10 border-t border-white/10 pt-8 md:mt-12 md:pt-10">
            <div
                class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                <div>
                    <h3 class="display-heading text-2xl md:text-3xl">
                        {colors.title}
                    </h3>
                    <p class="text-ink-muted mt-3 max-w-xl text-sm">
                        {colors.hint}
                    </p>
                </div>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {
                    cornerColors.map(color => (
                        <button
                            type="button"
                            class="group bg-ink-soft hover:border-luz-mint/60 focus:border-luz-mint flex min-h-28 items-center gap-4 rounded-lg border border-white/8 p-4 text-left transition focus:outline-none"
                            data-copy-color={color.hex}
                            aria-label={`${colors.copy} ${color.label} ${color.hex}`}>
                            <span
                                class="size-14 shrink-0 rounded-md border border-white/15 shadow-lg shadow-black/25"
                                style={`background-color: ${color.hex}`}
                                aria-hidden="true"
                            />
                            <span class="min-w-0">
                                <span class="stamp-num text-ink-muted block">
                                    {color.label}
                                </span>
                                <span class="text-paper mt-2 block font-semibold">
                                    {color.hex}
                                </span>
                                <span
                                    class="text-luz-mint mt-1 block text-xs opacity-0 transition group-hover:opacity-100 group-focus:opacity-100"
                                    data-copy-status
                                    data-copied={colors.copied}>
                                    {colors.copy}
                                </span>
                            </span>
                        </button>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    const copyText = async (value: string) => {
        await navigator.clipboard.writeText(value);
    };

    document
        .querySelectorAll<HTMLButtonElement>('[data-copy-color]')
        .forEach(button => {
            const status =
                button.querySelector<HTMLElement>('[data-copy-status]');
            const defaultLabel = status?.textContent ?? '';

            button.addEventListener('click', async () => {
                const color = button.dataset.copyColor;
                if (!color || !status) return;

                await copyText(color);
                status.textContent = status.dataset.copied ?? defaultLabel;
                status.classList.remove('opacity-0');

                window.setTimeout(() => {
                    status.textContent = defaultLabel;
                    status.classList.add('opacity-0');
                }, 1400);
            });
        });
</script>
