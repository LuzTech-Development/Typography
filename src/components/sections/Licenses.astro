---
import type { Locale } from '@/i18n';
import { t } from '@/lib/i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const l = dict.licenses;
---

<section id="licenses" class="border-b border-white/[0.06] py-24">
    <div class="container-editorial">
        <p class="eyebrow">{l.eyebrow}</p>
        <h2 class="display-heading mt-4 text-4xl md:text-5xl">{l.title}</h2>
        <p class="mt-6 max-w-2xl text-lg text-paper/75">{l.lede}</p>

        <div class="mt-12 grid gap-8 lg:grid-cols-3">
            <div class="rounded-xl border border-white/[0.08] bg-ink-soft p-8">
                <h3 class="text-xl font-bold">{l.mit.title}</h3>
                <p class="mt-1 text-sm text-luz-mint">{l.mit.subtitle}</p>
                <p class="mt-4 text-paper/75">{l.mit.summary}</p>
                <ul class="mt-4 space-y-2">
                    {
                        l.mit.points.map(point => (
                            <li class="flex gap-2 text-sm text-paper/75">
                                <span class="text-luz-mint" aria-hidden="true">✓</span>
                                <span>{point}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="rounded-xl border border-white/[0.08] bg-ink-soft p-8">
                <h3 class="text-xl font-bold">{l.ofl.title}</h3>
                <p class="mt-1 text-sm text-luz-mint">{l.ofl.subtitle}</p>
                <p class="mt-4 text-paper/75">{l.ofl.summary}</p>
                <ul class="mt-4 space-y-2">
                    {
                        l.ofl.points.map(point => (
                            <li class="flex gap-2 text-sm text-paper/75">
                                <span class="text-luz-mint" aria-hidden="true">✓</span>
                                <span>{point}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="rounded-xl border border-white/[0.08] bg-ink-soft p-8">
                <h3 class="text-xl font-bold">{l.trademark.title}</h3>
                <p class="mt-1 text-sm text-luz-mint">{l.trademark.subtitle}</p>
                <p class="mt-4 text-paper/75">{l.trademark.summary}</p>

                <h4 class="mt-6 text-sm font-semibold text-luz-mint">
                    {l.trademark.permitted.title}
                </h4>
                <ul class="mt-2 space-y-2">
                    {
                        l.trademark.permitted.items.map(item => (
                            <li class="flex gap-2 text-sm text-paper/75">
                                <span class="text-luz-mint" aria-hidden="true">✓</span>
                                <span>{item}</span>
                            </li>
                        ))
                    }
                </ul>

                <h4 class="mt-6 text-sm font-semibold text-red-400">
                    {l.trademark.restricted.title}
                </h4>
                <ul class="mt-2 space-y-2">
                    {
                        l.trademark.restricted.items.map(item => (
                            <li class="flex gap-2 text-sm text-paper/75">
                                <span class="text-red-400" aria-hidden="true">✕</span>
                                <span>{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
