---
import type { Locale } from '@/i18n';
import { localePrefix, t } from '@/lib/i18n';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const p = localePrefix(locale);

const navItems = [
    { href: `${p}/#instructions`, label: dict.nav.instructions },
    { href: `${p}/#licenses`, label: dict.nav.licenses },
    { href: `${p}/#icons`, label: dict.nav.icons },
    { href: `${p}/#font`, label: dict.nav.font }
];
---

<header
    class="fixed inset-x-0 top-0 z-40 border-b border-white/6 bg-ink/70 backdrop-blur-md"
>
    <div class="container-editorial flex h-16 items-center justify-between">
        <a
            href={`${p}/`}
            class="flex items-center gap-3 transition-opacity hover:opacity-80"
            aria-label="LuzTech Typography"
        >
            <img
                src="/icons/clean.svg"
                alt=""
                width={28}
                height={28}
                class="text-luz-mint"
                style="color: var(--color-luz-mint)"
                aria-hidden="true"
            />
            <span class="stamp-num">LuzTech Typography</span>
        </a>

        <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
            {
                navItems.map(item => (
                    <a
                        href={item.href}
                        class="stamp-num uppercase text-ink-muted transition-colors hover:text-paper"
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-3">
            <LanguageToggle locale={locale} />
        </div>
    </div>
</header>
