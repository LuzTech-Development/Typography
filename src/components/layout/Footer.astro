---
import type { Locale } from '@/i18n';
import { t } from '@/lib/i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();

const siteUrl = 'https://www.luztech.dev.br';
const repoUrl = 'https://github.com/Giancarl021/LuzTech-Typography';
---

<footer class="bg-ink border-t border-white/[0.06]">
    <div
        class="container-editorial flex flex-col items-center justify-between gap-3 py-8 md:flex-row">
        <p class="stamp-num">
            © {year} · LuzTech Development · {dict.footer.rights}
        </p>
        <div class="flex items-center gap-1">
            <a
                href={siteUrl}
                target="_blank"
                rel="noopener noreferrer"
                title="www.luztech.dev.br"
                aria-label="www.luztech.dev.br"
                class="group text-ink-muted hover:text-luz-mint inline-flex items-center p-2 transition-colors">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
                    ></path>
                    <path d="M2 12h20"></path>
                </svg>
                <span class="sr-only">www.luztech.dev.br</span>
            </a>
            <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                title="GitHub"
                aria-label="GitHub repository"
                class="group text-ink-muted hover:text-luz-mint inline-flex items-center p-2 transition-colors">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5">
                    <path
                        d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
                    ></path>
                </svg>
                <span class="sr-only">GitHub repository</span>
            </a>
        </div>
    </div>
</footer>
