---
import type { Locale } from '@/i18n';
import { t } from '@/lib/i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
---

<footer class="bg-ink border-t border-white/[0.06]">
    <div
        class="container-editorial flex flex-col justify-between gap-3 py-8 md:flex-row md:items-center">
        <p class="stamp-num">
            © {year} · LuzTech Development · {dict.footer.rights}
        </p>
        <p class="stamp-num text-ink-muted">{dict.footer.trademark}</p>
        <p class="stamp-num text-ink-muted">{dict.footer.builtWith}</p>
    </div>
</footer>
