---
/**
 * Root landing page.
 *
 * This page never renders content — it redirects visitors to the locale
 * that best matches their browser preferences, defaulting to English.
 */
import { localePaths } from '@/i18n';

const defaultTarget = `${localePaths['en-us']}/`;
const supportedJson = JSON.stringify(localePaths);
const siteURL = Astro.site ?? new URL('/', Astro.url);
const ptHref = new URL(localePaths['pt-br'] + '/', siteURL).href;
const enHref = new URL(localePaths['en-us'] + '/', siteURL).href;
const canonicalHref = new URL('/', siteURL).href;
const ogImageURL = new URL('/og-image-en.png', siteURL).href;
const alternates = [
    { hreflang: 'en', href: enHref, label: 'English' },
    { hreflang: 'pt-BR', href: ptHref, label: 'Português' }
];

const pageTitle =
    'LuzTech Typography — Icons, Font & Brand Assets Reference';
const pageDesc =
    'Official LuzTech visual identity reference: icons, typography, licenses, and brand assets.';
const ogImageAlt = 'LuzTech Typography';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,follow" />

        <title>{pageTitle}</title>
        <meta name="title" content={pageTitle} />
        <meta name="description" content={pageDesc} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="pt-BR" href={ptHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="LuzTech Development" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDesc} />
        <meta property="og:url" content={canonicalHref} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:locale:alternate" content="pt_BR" />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:secure_url" content={ogImageURL} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalHref} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDesc} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <meta http-equiv="refresh" content={`0; url=${defaultTarget}`} />
        <script is:inline define:vars={{ supportedJson, defaultTarget }}>
            (function () {
                try {
                    var localeToPath = JSON.parse(supportedJson);
                    var stored = null;
                    try {
                        stored = localStorage.getItem('preferred-locale');
                    } catch (_) {}
                    function pick(tag) {
                        if (!tag) return null;
                        if (localeToPath[tag]) return tag;
                        var lower = tag.toLowerCase();
                        if (lower.indexOf('pt') === 0) return 'pt-br';
                        if (lower.indexOf('en') === 0) return 'en-us';
                        return null;
                    }
                    var target = pick(stored);
                    var candidates =
                        (navigator.languages && navigator.languages.length
                            ? navigator.languages
                            : [navigator.language]) || [];
                    if (!target) {
                        for (var i = 0; i < candidates.length; i++) {
                            target = pick(candidates[i]);
                            if (target) break;
                        }
                    }
                    if (!target) target = 'en-us';
                    var path = localeToPath[target] || defaultTarget;
                    location.replace(path + '/');
                } catch (_) {
                    location.replace(defaultTarget);
                }
            })();
        </script>
    </head>
    <body>
        <noscript>
            <h1>LuzTech Typography</h1>
            <p>Select a language / Selecione um idioma:</p>
            <ul>
                {
                    alternates.map(alt => (
                        <li>
                            <a href={alt.href}>{alt.label}</a>
                        </li>
                    ))
                }
            </ul>
        </noscript>
    </body>
</html>
