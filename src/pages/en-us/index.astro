---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import Instructions from '@/components/sections/Instructions.astro';
import Licenses from '@/components/sections/Licenses.astro';
import Icons from '@/components/sections/Icons.astro';
import Font from '@/components/sections/Font.astro';

const locale = 'en-us';
---

<Layout locale={locale}>
    <Hero locale={locale} />
    <Instructions locale={locale} />
    <Licenses locale={locale} />
    <Icons locale={locale} />
    <Font locale={locale} />
</Layout>
